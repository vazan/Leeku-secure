# ============================================================
# LEEKU SECURE — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in ALL values marked CHANGE_ME.
# NEVER commit .env to source control.
# On Windows Server 2022, protect this file with NTFS permissions
# so only the service account running Node.js can read it.
# ============================================================


# ----------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Public URL of the application
APP_URL="https://leeks.miku.rip"

# Comma-separated allowed origins for CORS (no trailing slash)
ALLOWED_ORIGINS=https://leeks.miku.rip

# Trusted reverse-proxy hops (set to 1 if behind Nginx/IIS ARR)
PROXY_TRUST_HOPS=1


# ----------------------------------------------------------------
# SSL / TLS (HTTPS)
# Leave SSL_ENABLED=false if HTTPS is terminated by a reverse proxy
# (Nginx, IIS ARR, Cloudflare, etc.) — the Node process itself does
# not need to handle TLS in that case.
#
# When SSL_ENABLED=true, Node.js creates an https.Server using the
# certificate and key at the paths below.
#
# On Windows Server 2022 you can use:
#   * A certificate issued by a public CA (Let's Encrypt, DigiCert, …)
#   * An internal / self-signed cert generated with:
#       openssl req -x509 -newkey rsa:4096 -nodes \
#         -keyout C:\LeekuSecure\ssl\server.key \
#         -out    C:\LeekuSecure\ssl\server.crt \
#         -days 825 -subj "/CN=leeks.miku.rip"
#   * A PFX/PKCS#12 exported from Windows Certificate Manager
#     (use SSL_PFX_PATH + SSL_PFX_PASSPHRASE instead of cert/key).
#
# NTFS permissions: restrict the key file to the service account only.
#   icacls "C:\LeekuSecure\ssl\server.key" /inheritance:r /grant "LEEKUUSER:(R)"
# ----------------------------------------------------------------
SSL_ENABLED=false

# ---- Option A: PEM certificate + private key (most common) ----
# Full path to the PEM-encoded certificate file (.crt / .pem)
SSL_CERT_PATH=C:\LeekuSecure\ssl\server.crt

# Full path to the PEM-encoded private key file (.key / .pem)
SSL_KEY_PATH=C:\LeekuSecure\ssl\server.key

# Optional: PEM-encoded intermediate / CA bundle to complete the chain
# Leave blank if your certificate file already includes the full chain.
SSL_CA_PATH=

# ---- Option B: PFX / PKCS#12 bundle (Windows Certificate export) ----
# If set, SSL_PFX_PATH takes precedence over SSL_CERT_PATH / SSL_KEY_PATH.
SSL_PFX_PATH=
SSL_PFX_PASSPHRASE=

# HTTPS port (default 443; use 8443 for unprivileged dev runs)
SSL_PORT=443

# Minimum TLS version accepted. TLSv1.2 is the minimum for PCI-DSS / HIPAA.
# Options: TLSv1.2 | TLSv1.3
SSL_MIN_VERSION=TLSv1.2

# Colon-separated OpenSSL cipher suite string.
# Leave blank to use Node.js defaults (recommended unless you have
# a specific compliance requirement).
SSL_CIPHERS=


# ----------------------------------------------------------------
# SQL SERVER 2022
# ----------------------------------------------------------------
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=LeekuSecure
DB_USER=leeku_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Connection pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_REQUEST_TIMEOUT_MS=15000
DB_CONNECTION_TIMEOUT_MS=30000

# Set to true to encrypt the SQL Server connection (recommended for production)
DB_ENCRYPT=true

# Set to false only if using a self-signed cert on the SQL Server (dev only)
DB_TRUST_SERVER_CERTIFICATE=false


# ----------------------------------------------------------------
# MASTER ENCRYPTION KEY
# Used to derive all application sub-keys via HKDF-SHA256.
# MUST be 32 cryptographically random bytes, base64-encoded.
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# On Windows Server 2022, consider protecting this value with:
#   * Windows DPAPI (CryptProtectData) — ties key to the service
#     account identity; requires node-dpapi native module.
#   * Azure Key Vault (if the server has a managed identity).
#   * At minimum: NTFS ACL so only the service account can read .env
# ----------------------------------------------------------------
MASTER_KEY_BASE64=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOMBYTES_32


# ----------------------------------------------------------------
# COOKIE / SESSION SECURITY
# ----------------------------------------------------------------
# Secret for signing HttpOnly session cookies (32+ random bytes, base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COOKIE_SECRET_BASE64=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOMBYTES_32

# Cookie domain (set to your actual domain in production)
COOKIE_DOMAIN=leeks.miku.rip

# Set to true in production (requires HTTPS)
COOKIE_SECURE=true


# ----------------------------------------------------------------
# JWT — RS256 (4096-bit RSA key pair)
# Generate:
#   openssl genrsa -out jwt_private.pem 4096
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Store keys outside the project directory, readable only by
# the service account (icacls or Set-Acl in PowerShell).
# ----------------------------------------------------------------
JWT_PRIVATE_KEY_PATH=C:\LeekuSecure\keys\jwt_private.pem
JWT_PUBLIC_KEY_PATH=C:\LeekuSecure\keys\jwt_public.pem

# Access token lifetime in seconds (default: 15 minutes)
JWT_ACCESS_EXPIRY_SECONDS=900

# Refresh token lifetime in seconds (default: 7 days)
JWT_REFRESH_EXPIRY_SECONDS=604800

# JWT issuer claim — must match your domain
JWT_ISSUER=https://leeks.miku.rip

# JWT audience claim
JWT_AUDIENCE=leeku-secure-api


# ----------------------------------------------------------------
# FILE STORAGE
# ----------------------------------------------------------------
# UNC path to the network share where encrypted vault files are stored.
# The service account running Node.js must have Read/Write access.
# Example: \\10.10.11.85\hyperv_storage
FILE_STORAGE_UNC_PATH=\\10.10.11.85\hyperv_storage

# Optional user-data root. Each user's latest 10 pictures are stored in:
# PROFILE_PICTURE_PATH\<user-id>\avatars\<generated-filename>
PROFILE_PICTURE_PATH=\\10.10.11.85\hyperv_storage\users

# ----------------------------------------------------------------
# UNC SHARE AUTO-MOUNT (optional)
# ----------------------------------------------------------------
# If the Windows service account is already granted access to the share
# (preferred — configure this in Active Directory or local security
# policy) you do NOT need these vars. Leave them blank.
#
# Only set these if the service account cannot authenticate to the
# share automatically (e.g., workgroup environment, cross-domain).
# The application calls `net use` at startup with these credentials.
#
# SECURITY RULES:
#   - NEVER commit .env to source control.
#   - Protect this file with NTFS permissions:
#       icacls ".env" /inheritance:r /grant "LEEKUUSER:(R)"
#   - Rotate the password here whenever the share password changes.
#   - The preferred alternative is to configure the service account
#     with a pre-mapped persistent credential via:
#       cmdkey /add:10.10.11.85 /user:hypervisor /pass:<password>
#     and then leave the three vars below empty.
#
# Path of the share to mount (same as FILE_STORAGE_UNC_PATH)
STORAGE_NET_USE_PATH=\\10.10.11.85\hyperv_storage
# Domain\Username or just Username for the share
STORAGE_NET_USE_USER=hypervisor
# Password for the share account — store ONLY here, never in code
STORAGE_NET_USE_PASS=CHANGE_ME

# Local temp directory for scan staging. Cleaned after every scan.
# Keep this on LOCAL disk — Bitdefender GravityZone can scan UNC/Samba
# paths but is extremely slow on writes over SMB. Local staging keeps
# scan time negligible and upload latency low.
FILE_SCAN_TEMP_PATH=C:\LeekuTemp\scan-staging

# Temp directory for incoming multipart uploads before scanning and encryption.
# Files are streamed here by multer, scanned locally by Bitdefender, encrypted,
# then the encrypted output is moved to FILE_STORAGE_UNC_PATH.
#
# MUST be on a LOCAL disk — staging on a UNC/Samba share causes severe upload
# slowdowns because Bitdefender scans over SMB are orders of magnitude slower
# than local-disk scans (tested: GravityZone on \\10.10.11.85\hyperv_storage).
# Downloads are unaffected because they stream an already-encrypted blob from
# the share without triggering an on-write scan.
#
# Ensure the local disk has enough free space for the largest expected upload × 2
# (plaintext + encrypted simultaneously).
UPLOAD_TEMP_PATH=C:\LeekuTemp\uploads

# Maximum HTTP body size for JSON endpoints (auth/profile/share).
# Uploads bypass this limit — they use multipart/form-data streaming.
# Default: 1 MB is plenty for JSON payloads.
MAX_UPLOAD_BODY_MB=1


# ----------------------------------------------------------------
# BITDEFENDER ENDPOINT SECURITY SDK / CLI
# ----------------------------------------------------------------
# Full path to the Bitdefender command-line scanner executable.
# Preferred: product.console.exe (faster, more modern)
# Legacy:    bdscan.exe (still works)
#
# Common locations on Windows Server 2022:
#   C:\Program Files\Bitdefender\Endpoint Security Tools\product.console.exe
#   C:\Program Files\Bitdefender\Endpoint Security\product.console.exe
#   C:\Program Files\Bitdefender\Endpoint Security Tools\bdscan.exe
#
# Verify your exact path with:
#   Get-ChildItem "C:\Program Files\Bitdefender" -Recurse -Filter "product.console.exe"
#   Get-ChildItem "C:\Program Files\Bitdefender" -Recurse -Filter "bdscan.exe"
#
# Leave blank or omit to enable auto-detection (recommended).
BITDEFENDER_SCAN_CLI_PATH=

# Maximum milliseconds to wait for a scan result before aborting
BITDEFENDER_TIMEOUT_MS=30000

# Optional extra arguments passed to the scanner before the file path
BITDEFENDER_EXTRA_ARGS=

# Development only. When NODE_ENV=development and Bitdefender is not installed,
# uploads continue after heuristic checks so local development remains usable.
# Set to false to test production-style fail-closed behavior locally.
ALLOW_UNSCANNED_UPLOADS_IN_DEVELOPMENT=true


# ----------------------------------------------------------------
# FILE AUTO-EXPIRY / TTL
# ----------------------------------------------------------------
# How often the expiry cleanup job runs (milliseconds).
# Default: 60 000 ms = every 60 seconds
EXPIRY_CLEANUP_INTERVAL_MS=60000


# ----------------------------------------------------------------
# RATE LIMITING & BRUTE-FORCE PROTECTION
# ----------------------------------------------------------------
# Maximum consecutive failed login attempts before account lockout
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in minutes after exceeding MAX_LOGIN_ATTEMPTS
LOCKOUT_DURATION_MINUTES=15

# Maximum requests per IP per minute on /api/auth/* endpoints
AUTH_RATE_LIMIT_RPM=20

# Maximum requests per IP per minute on all other /api/* endpoints
API_RATE_LIMIT_RPM=120


# ----------------------------------------------------------------
# EMAIL VERIFICATION (SMTP)
# ----------------------------------------------------------------
# SMTP server for sending account verification emails.
# The application validates the recipient's domain MX record before sending.
#
# Common providers:
#   Gmail:       smtp.gmail.com    port 587  SECURE=false (STARTTLS)
#   Outlook:     smtp.office365.com port 587 SECURE=false (STARTTLS)
#   Amazon SES:  email-smtp.us-east-1.amazonaws.com port 587
#
# If SMTP_HOST is blank, email verification is skipped (dev only).
# ----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@leeku.rip
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
SMTP_FROM=noreply@leeku.rip


# ----------------------------------------------------------------
# GOOGLE GEMINI API (AI-generated leeku vibe scan messages)
# ----------------------------------------------------------------
GEMINI_API_KEY="CHANGE_ME"


# ----------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------
# Log level: error | warn | info | debug
LOG_LEVEL=info

# Maximum number of system log entries returned by the admin API
MAX_LOG_ENTRIES=500


# ----------------------------------------------------------------
# IIS W3C EXTENDED LOG FORMAT (Windows Server 2022)
# ----------------------------------------------------------------
# Leeku can log HTTP requests in IIS W3C Extended Log Format for
# compatibility with IIS analytics tools and compliance reporting.
#
# When IIS_LOGS_ENABLED=true, every HTTP request is logged to:
#   C:\inetpub\logs\LogFiles\W3SVC{IIS_SITE_ID}\leeku_secure_YYYY-MM-DD.log
#
# This complements the Node.js console/file logging and system_logs table
# and is useful for:
#   • IIS-integrated analytics dashboards
#   • Security / compliance audits
#   • Performance analysis in IIS Manager
# ----------------------------------------------------------------
IIS_LOGS_ENABLED=false

# IIS Site ID (integer identifier of the site in IIS Manager)
# Default: 1 (Default Web Site)
# To find your site ID, run: Get-IISSite | Select-Object Name, Id
IIS_SITE_ID=1

# Custom IIS log directory (optional)
# If blank, defaults to: C:\inetpub\logs\LogFiles\W3SVC{IIS_SITE_ID}
# Example: C:\inetpub\logs\LeekuSecure
IIS_LOGS_PATH=

# W3C Extended Log fields to record
# Common fields:
#   date, time, s-ip, cs-method, cs-uri-stem, cs-uri-query, s-port,
#   cs-username, c-ip, cs(User-Agent), sc-status, sc-bytes, cs-bytes, time-taken
# Space-separated list (leave blank for default set)
IIS_LOG_FIELDS=date time s-ip cs-method cs-uri-stem cs-uri-query s-port cs-username c-ip cs(User-Agent) sc-status sc-bytes cs-bytes time-taken

# Roll IIS logs daily (true) or append to same file (false)
IIS_LOGS_DAILY_ROLLOVER=true
