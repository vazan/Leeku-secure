# Docker development environment example for Leeku Secure
# Copy to: .env.docker.dev and replace placeholder values.

# PostgreSQL container credentials
POSTGRES_DB=LeekuSecure
POSTGRES_USER=leeku_app
POSTGRES_PASSWORD=change_me_dev_only

# App exposure
APP_PORT=3000

# Runtime mode
NODE_ENV=development
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Required app secrets (32 random bytes, base64)
MASTER_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTES
COOKIE_SECRET_BASE64=REPLACE_WITH_BASE64_32_BYTES

# Local paths inside app container
FILE_STORAGE_UNC_PATH=/app/vault
UPLOAD_TEMP_PATH=/app/uploads
FILE_SCAN_TEMP_PATH=/app/scan-temp

# Optional tuning
DB_WAIT_TIMEOUT=90
PROXY_TRUST_HOPS=0
COOKIE_SECURE=false
DB_SSL=false
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=false
