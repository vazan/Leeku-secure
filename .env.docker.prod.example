# Docker production environment example for Leeku Secure
# Copy to: .env.docker.prod and replace all placeholder values.

# PostgreSQL container credentials
POSTGRES_DB=LeekuSecure
POSTGRES_USER=leeku_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# App exposure
APP_PORT=3000

# Runtime mode
NODE_ENV=production
APP_URL=https://your-domain.example
ALLOWED_ORIGINS=https://your-domain.example

# Required app secrets (32 random bytes, base64)
MASTER_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTES
COOKIE_SECRET_BASE64=REPLACE_WITH_BASE64_32_BYTES

# Cookie/proxy security
COOKIE_SECURE=true
PROXY_TRUST_HOPS=1

# DB connection settings
DB_SSL=false
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=false

# Paths inside app container
FILE_STORAGE_UNC_PATH=/app/vault
UPLOAD_TEMP_PATH=/app/uploads
FILE_SCAN_TEMP_PATH=/app/scan-temp

# Optional key/scanner paths (set if used in your deployment)
JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt_public.pem
BITDEFENDER_SCAN_CLI_PATH=/opt/bitdefender/product.console.exe

# Optional tuning
DB_WAIT_TIMEOUT=120
