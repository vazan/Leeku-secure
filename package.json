{
  "name": "leeku-secure",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names client,server \"vite --host 0.0.0.0\" \"cross-env NODE_ENV=development tsx watch src/server.ts\"",
    "build": "cross-env NODE_ENV=production vite build && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "preview": "cross-env NODE_ENV=production node dist/server.mjs",
    "start": "cross-env NODE_ENV=production node dist/server.mjs",
    "clean": "rimraf dist",
    "test:desktop-updates": "tsx --test tests/desktop-updates-path.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/msal-node": "^7.1.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@google/genai": "^2.29.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "highlight.js": "^11.12.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.57.0",
    "motion": "^12.43.0",
    "mssql": "^12.7.6",
    "multer": "^2.4.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.1",
    "papaparse": "^5.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "shadcn": "^4.21.5",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "systeminformation": "^5.33.15",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@azure/identity": "^4.15.0-beta.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.1",
    "uuid": "^11.1.1"
  }
}
